Screen {
    padding: 0;
    background: $background;
    layout: vertical;
}

HeaderIcon {
    display: none;
}

#title { color: $primary; text-style: bold; }

#input {   
    height: 3;
    border: heavy $primary;
    background: transparent;
    padding: 0 0;
    margin: 0;
}
#input:focus { border: heavy $accent; }

#output {
    height: 1fr;
    width: 1fr;
    border: heavy $primary;
    background: transparent;
    overflow-x: hidden;
    overflow-y: auto;
    text-wrap:  wrap;
}
#output:focus   { border: heavy $accent; }

#output ScrollBar { background: transparent; }
ScrollBar { background: $primary; }

#main-container { height: 1fr; width: 1fr; }

#sidebar {
    width: 15%;
    min-width: 15;
    height: 1fr;
}
#chat-list {
    height: 1fr;
    border: heavy $primary;
    background: transparent;
}
#chat-list:focus { border: heavy $accent; }

#chat-area {
    width: 1fr;
    height: 1fr;
    padding: 0;
    margin: 0;
}

Toast {
    width: 40;
    max-width: 40%;
    padding: 0 1;
    margin-bottom: 1;
}

ConfirmScreen, CreateChatScreen, RenameChatScreen {
    align: center middle;
    background: $background 80%;
}

#dialog-input {
    height: 3;
    border: heavy $primary;
    background: transparent;
    padding: 0 0;
    margin: 0;
    width: 50%;
}
#dialog-input:focus { border: heavy $accent; }

#dialog-grid {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    width: 50;
    height: 8;
    padding: 0 1;
    border: thick $background 80%;
    background: $surface;
}
#dialog-question {
    column-span: 2;
    text-align: center;
    width: 100%;
    content-align: center middle;
}
#dialog-confirm-button, #dialog-cancel-button { width: 100%; }

#create-chat-dialog-grid {
    grid-size: 2;
    grid-gutter: 1 2;
    width: 60;
    height: auto;
    padding: 0 0;
    border: thick $background 80%;
    background: $surface;
}
#create-chat-label {
    column-span: 2;
    width: 100%;
    height: 1;
    margin: 0;
    content-align: center middle;
}
#input-name, #input-uuid {
    column-span: 2;
    width: 100%;
    height: 3;
    border: heavy $primary;
    background: transparent;
    padding: 0 0;
    margin: 0;
    margin-bottom: 0;
}
#input-name:focus, #input-uuid:focus { border: heavy $accent; }